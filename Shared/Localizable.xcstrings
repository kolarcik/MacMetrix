    },
    "Průměrné zatížení" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load average"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průměrné zatížení"
          }
        }
      }
    },
    "Průvodce najde soubory, které se dají bezpečně smazat – mezivýsledky buildů Xcode a .NET, cache balíčkovacích nástrojů, staré dočasné soubory a logy. Před smazáním uvidíš, co a kolik místa se uvolní, a vybereš si kategorie." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wizard finds files that are safe to delete – intermediate Xcode and .NET build results, package manager caches, old temporary files and logs. Before deleting you see what will be removed and how much space it frees, and you choose the categories."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průvodce najde soubory, které se dají bezpečně smazat – mezivýsledky buildů Xcode a .NET, cache balíčkovacích nástrojů, staré dočasné soubory a logy. Před smazáním uvidíš, co a kolik místa se uvolní, a vybereš si kategorie."
          }
        }
      }
    },
    "Průvodce prochází jen známé složky s cache a build výstupy a vámi zvolenou složku s projekty. Výsledky hledání zůstávají v paměti a nikam se neposílají." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wizard only goes through known cache and build output folders and the projects folder you choose. The search results stay in memory and are not sent anywhere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průvodce prochází jen známé složky s cache a build výstupy a vámi zvolenou složku s projekty. Výsledky hledání zůstávají v paměti a nikam se neposílají."
          }
        }
      }
    },
    "Průvodce úklidem disku maže jen kategorie, které sami vyberete a potvrdíte. Trvale smazané soubory nejde obnovit – pokud si nejste jisti, zvolte přesun do Koše. Za smazaná data odpovídá uživatel." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk cleanup wizard deletes only the categories you select and confirm. Permanently deleted files can't be recovered – if you are not sure, choose moving to the Trash. The user is responsible for deleted data."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Průvodce úklidem disku maže jen kategorie, které sami vyberete a potvrdíte. Trvale smazané soubory nejde obnovit – pokud si nejste jisti, zvolte přesun do Koše. Za smazaná data odpovídá uživatel."
          }
        }
      }
    },
    "R %@ · W %@ · %@ volno" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "R %1$@ · W %2$@ · %3$@ volno"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R %1$@ · W %2$@ · %3$@ free"
          }
        }
      }
    },
    "Renderer" : {
      "localizations" : {
